{
  "bsonType": "object",
  "required": ["role"],
  "permission": { "read": false, "create": false, "update": false, "delete": false },
  "description": "用户/骑手扩展资料。_id 与 uni-id-users._id 一致。所有读写只允许云函数。",
  "properties": {
    "_id": { "description": "用户ID（等于 uni-id-users._id）" },
    "role": { "bsonType": "string", "enum": ["user", "rider", "admin"], "description": "当前身份" },
    "nickname": { "bsonType": "string", "maxLength": 20, "description": "昵称" },
    "avatar": { "bsonType": "string", "maxLength": 300, "description": "头像地址" },
    "mobile": { "bsonType": "string", "description": "手机号（敏感，只下发脱敏值）" },
    "school": { "bsonType": "string", "description": "学校，固定浙江中医药大学" },

    "rider_status": { "bsonType": "int", "description": "骑手状态 0未申请 1审核中 2已通过 3已拒绝" },
    "real_name": { "bsonType": "string", "description": "真实姓名（仅平台审核可见，绝不下发给用户端）" },
    "student_no": { "bsonType": "string", "description": "学号（仅平台审核可见）" },
    "rider_apply_time": { "bsonType": "timestamp", "description": "申请成为骑手的时间" },

    "rating": { "bsonType": "double", "description": "骑手评分 0-5" },
    "rider_rating_count": { "bsonType": "int", "description": "被评价次数" },

    "published_count": { "bsonType": "int", "description": "发布订单数" },
    "accepted_count": { "bsonType": "int", "description": "完成订单数" },
    "total_income_cent": { "bsonType": "int", "description": "累计收入（分）" },

    "create_time": { "bsonType": "timestamp" },
    "update_time": { "bsonType": "timestamp" }
  }
}
