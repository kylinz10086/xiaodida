{
  "bsonType": "object",
  "required": ["balance_cent"],
  "permission": { "read": false, "create": false, "update": false, "delete": false },
  "description": "钱包。金额一律整数分。只允许云函数读写，且只能通过记账函数变动。",
  "properties": {
    "_id": { "description": "用户ID" },
    "balance_cent": { "bsonType": "int", "minimum": 0, "description": "可用余额（分）" },
    "frozen_cent": { "bsonType": "int", "minimum": 0, "description": "冻结中（提现审核中）" },
    "income_cent": { "bsonType": "int", "minimum": 0, "description": "累计收入" },
    "withdrawn_cent": { "bsonType": "int", "minimum": 0, "description": "累计已提现" },
    "create_time": { "bsonType": "timestamp" },
    "update_time": { "bsonType": "timestamp" }
  }
}
