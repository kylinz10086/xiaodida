{
  "bsonType": "object",
  "required": ["type", "user_id", "amount_cent", "idempotency_key"],
  "permission": { "read": false, "create": false, "update": false, "delete": false },
  "description": "资金流水。只能新增，不允许修改/删除。idempotency_key 唯一索引保证同一笔业务只记一次。",
  "properties": {
    "_id": { "description": "流水ID" },
    "type": {
      "bsonType": "string",
      "enum": ["escrow_in", "escrow_out", "income", "commission", "refund", "withdraw"],
      "description": "托管入账 / 托管出账 / 骑手收入 / 平台佣金 / 退款 / 提现"
    },
    "user_id": { "bsonType": "string", "description": "归属用户；平台账户用 platform" },
    "task_id": { "bsonType": "string", "description": "关联订单" },
    "amount_cent": { "bsonType": "int", "description": "变动金额（分），正数入账负数出账" },
    "remark": { "bsonType": "string", "maxLength": 200 },
    "idempotency_key": { "bsonType": "string", "description": "幂等键，唯一索引" },
    "create_time": { "bsonType": "timestamp" }
  }
}
