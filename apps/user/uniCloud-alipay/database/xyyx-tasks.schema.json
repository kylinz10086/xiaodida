{
  "bsonType": "object",
  "required": ["title", "type", "amount_cent", "status", "publisher_id"],
  "permission": { "read": false, "create": false, "update": false, "delete": false },
  "description": "跑腿订单。金额一律用整数分。所有读写只允许云函数（客户端不可直连）。",
  "properties": {
    "_id": { "description": "订单ID" },
    "title": { "bsonType": "string", "maxLength": 40, "description": "任务标题" },
    "type": { "bsonType": "int", "enum": [1, 2, 3], "description": "1快递代取 2代带餐食 3其他" },
    "type_text": { "bsonType": "string", "description": "类型中文" },
    "description": { "bsonType": "string", "maxLength": 300, "description": "详细描述" },

    "amount_cent": { "bsonType": "int", "minimum": 100, "description": "订单金额（分），改价后为最新价格" },
    "commission_cent": { "bsonType": "int", "description": "平台佣金（分），结算时写入" },
    "rider_income_cent": { "bsonType": "int", "description": "骑手实得（分），结算时写入" },
    "refund_cent": { "bsonType": "int", "description": "累计已退金额（分）" },
    "refund_status": {
      "bsonType": "string",
      "enum": ["", "processing", "partial", "done", "failed"],
      "description": "退款进度：空=没退过 / 退款中 / 部分退款 / 已退完 / 退款失败"
    },
    "paid_cent": { "bsonType": "int", "description": "累计实付金额（分），含涨价补的差价" },
    "due_cent": {
      "bsonType": "int",
      "description": "改价涨价后还差多少没付（分）。>0 时 pay_status 为 partial，订单不进大厅"
    },
    "payments": {
      "bsonType": "array",
      "description": "支付明细：[{ no: out_trade_no, cent, type: full|topup, time, refunded }]，退款按这里逐笔发起"
    },
    "pending_pay_no": { "bsonType": "string", "description": "本轮待支付的 out_trade_no" },
    "pending_pay_cent": { "bsonType": "int", "description": "本轮应支付的金额（分）" },
    "pending_pay_time": { "bsonType": "timestamp" },
    "update_count": { "bsonType": "int", "description": "被修改过几次" },
    "update_time": { "bsonType": "timestamp" },

    "item_type": { "bsonType": "string", "maxLength": 20, "description": "物品类型" },
    "item_size": { "bsonType": "string", "maxLength": 20, "description": "物品大小" },
    "item_weight": { "bsonType": "string", "maxLength": 20, "description": "重量" },
    "time_option": { "bsonType": "string", "maxLength": 30, "description": "时间要求" },

    "origin": {
      "bsonType": "object",
      "description": "取件地点",
      "properties": {
        "name": { "bsonType": "string", "maxLength": 60 },
        "detail": { "bsonType": "string", "maxLength": 120 },
        "latitude": { "bsonType": "double" },
        "longitude": { "bsonType": "double" }
      }
    },
    "destination": {
      "bsonType": "object",
      "description": "送达地点",
      "properties": {
        "name": { "bsonType": "string", "maxLength": 60 },
        "detail": { "bsonType": "string", "maxLength": 120 },
        "latitude": { "bsonType": "double" },
        "longitude": { "bsonType": "double" }
      }
    },

    "mobile": { "bsonType": "string", "description": "联系手机号（敏感，按角色脱敏下发）" },
    "wechat_id": { "bsonType": "string", "maxLength": 40, "description": "微信号" },
    "remark": { "bsonType": "string", "maxLength": 200 },
    "images": { "bsonType": "array", "maxItems": 6, "description": "图片地址列表" },
    "pick_proof": { "bsonType": "string", "maxLength": 300, "description": "取件留痕图片 fileID" },
    "deliver_proof": { "bsonType": "string", "maxLength": 300, "description": "送达留痕图片 fileID" },

    "status": { "bsonType": "int", "enum": [1, 2, 3, 4, 5], "description": "1待接单 2进行中 3已完成 4已取消 5售后" },
    "pay_status": {
      "bsonType": "string",
      "enum": ["unpaid", "partial", "paid", "refunding", "refunded"],
      "description": "支付状态：未支付 / 已付一部分（涨价待补差价） / 已付清 / 退款中 / 已退款"
    },
    "pay_mode": { "bsonType": "string", "description": "mock / wechat" },
    "transaction_id": { "bsonType": "string", "description": "微信支付单号" },

    "school": { "bsonType": "string", "description": "学校，固定值" },
    "publisher_id": { "bsonType": "string", "description": "发布者 uid" },
    "publisher_nickname": { "bsonType": "string" },
    "publisher_avatar": { "bsonType": "string" },
    "runner_id": { "bsonType": "string", "description": "接单骑手 uid" },
    "runner_nickname": { "bsonType": "string" },
    "runner_avatar": { "bsonType": "string" },
    "runner_rating": { "bsonType": "double" },
    "runner_accepted_count": { "bsonType": "int" },

    "create_time": { "bsonType": "timestamp" },
    "pay_time": { "bsonType": "timestamp" },
    "accept_time": { "bsonType": "timestamp" },
    "picked_time": { "bsonType": "timestamp" },
    "delivered_time": { "bsonType": "timestamp" },
    "auto_confirm_at": { "bsonType": "timestamp", "description": "超时自动确认时间" },
    "complete_time": { "bsonType": "timestamp" },
    "complete_by": { "bsonType": "string", "description": "谁确认的（用户 uid 或 auto）" },
    "cancel_time": { "bsonType": "timestamp" },
    "cancel_reason": { "bsonType": "string" },
    "abandon_time": { "bsonType": "timestamp" },
    "abandon_reason": { "bsonType": "string" }
  }
}
