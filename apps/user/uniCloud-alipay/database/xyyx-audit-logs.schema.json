{
  "bsonType": "object",
  "required": ["action", "create_time"],
  "permission": { "read": false, "create": false, "update": false, "delete": false },
  "description": "审计日志。谁在什么时候对谁做了什么（后台审核、退款、提现、风控拦截、内容违规）。只写不删，全部经云对象写入，客户端不可读写。",
  "properties": {
    "_id": { "description": "记录ID" },
    "action": { "bsonType": "string", "maxLength": 64, "description": "动作名，格式「模块.动作」，如 rider.review / pay.withdraw / risk.block" },
    "actor_uid": { "bsonType": "string", "maxLength": 64, "description": "操作者用户ID（系统任务为空）" },
    "actor_role": { "bsonType": "string", "maxLength": 16, "description": "操作者身份 user/rider/admin" },
    "target_type": { "bsonType": "string", "maxLength": 32, "description": "对象类型 user/task/withdraw/refund/settings/text" },
    "target_id": { "bsonType": "string", "maxLength": 64, "description": "对象ID" },
    "result": { "bsonType": "string", "maxLength": 16, "description": "结果 ok/blocked/logged/failed" },
    "detail": { "bsonType": "object", "description": "附加上下文（超过 2000 字符会被截断成摘要）" },
    "create_time": { "bsonType": "timestamp", "description": "发生时间" }
  }
}
