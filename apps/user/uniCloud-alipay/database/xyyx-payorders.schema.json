{
  "bsonType": "object",
  "required": ["out_trade_no", "task_id", "amount_cent", "status"],
  "permission": { "read": false, "create": false, "update": false, "delete": false },
  "description": "支付单登记。每次发起支付（全款/补差价）都记一条，微信回调只带 out_trade_no，靠这张表保证「一笔迟到的支付」也一定能对回到自己的订单，不会出现付了钱没记账。",
  "properties": {
    "_id": { "description": "支付单ID" },
    "out_trade_no": { "bsonType": "string", "description": "微信 out_trade_no（服务端生成，≤32 位）" },
    "task_id": { "bsonType": "string", "description": "关联订单" },
    "user_id": { "bsonType": "string", "description": "付款用户" },
    "amount_cent": { "bsonType": "int", "minimum": 1, "description": "本笔支付金额（分）" },
    "type": {
      "bsonType": "string",
      "enum": ["full", "topup"],
      "description": "full=下单全款；topup=修改订单涨价后补的差价"
    },
    "status": {
      "bsonType": "string",
      "enum": ["pending", "paid", "closed"],
      "description": "支付单状态"
    },
    "transaction_id": { "bsonType": "string", "description": "微信支付单号" },
    "create_time": { "bsonType": "timestamp" },
    "update_time": { "bsonType": "timestamp" },
    "pay_time": { "bsonType": "timestamp" }
  }
}
