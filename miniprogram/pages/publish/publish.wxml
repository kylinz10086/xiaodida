<view class="page">
  <!-- 类型 -->
  <view class="section">
    <view class="section-title">需求类型</view>
    <view class="type-row">
      <view
        class="type-btn {{type === (index + 1) ? 'active' : ''}}"
        wx:for="{{typeList}}"
        wx:key="*this"
        data-type="{{index + 1}}"
        bindtap="switchType"
      >{{item}}</view>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="section">
    <view class="section-title">任务信息</view>

    <view class="field">
      <text class="field-label">任务标题<text class="required">*</text></text>
      <input
        class="field-input"
        value="{{title}}"
        maxlength="30"
        placeholder="一句话说清要做什么"
        placeholder-class="ph"
        data-field="title"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <text class="field-label">详细描述</text>
      <textarea
        class="field-textarea"
        value="{{description}}"
        maxlength="200"
        placeholder="物品大小、特殊要求、送达楼层等"
        placeholder-class="ph"
        data-field="description"
        bindinput="onInput"
      />
    </view>

    <view class="field-inline">
      <view class="field-inline-item">
        <text class="field-label">物品类型</text>
        <input class="field-input" value="{{itemType}}" placeholder="快递 / 外卖" placeholder-class="ph" data-field="itemType" bindinput="onInput" />
      </view>
      <view class="field-inline-item">
        <text class="field-label">预估重量</text>
        <input class="field-input" value="{{itemWeight}}" placeholder="约2kg" placeholder-class="ph" data-field="itemWeight" bindinput="onInput" />
      </view>
    </view>

    <view class="field">
      <text class="field-label">物品大小</text>
      <view class="chip-row">
        <view
          class="chip {{itemSize === item ? 'active' : ''}}"
          wx:for="{{sizeOptions}}"
          wx:key="*this"
          data-value="{{item}}"
          bindtap="selectSize"
        >{{item}}</view>
      </view>
    </view>
  </view>

  <!-- 地点 -->
  <view class="section">
    <view class="section-title">取送地点</view>

    <view class="address-row">
      <text class="point start">起</text>
      <input class="field-input address-input" value="{{originName}}" placeholder="取件地点，如 东门菜鸟驿站" placeholder-class="ph" data-field="originName" bindinput="onInput" />
      <view class="locate-btn" data-which="origin" bindtap="useCurrentLocation">定位</view>
    </view>

    <view class="address-row">
      <text class="point end">终</text>
      <input class="field-input address-input" value="{{destinationName}}" placeholder="送达地点，如 学生公寓3号楼" placeholder-class="ph" data-field="destinationName" bindinput="onInput" />
      <view class="locate-btn" data-which="destination" bindtap="useCurrentLocation">定位</view>
    </view>
  </view>

  <!-- 时间 -->
  <view class="section">
    <view class="section-title">时间要求</view>
    <view class="chip-row">
      <view
        class="chip {{timeOption === item ? 'active' : ''}}"
        wx:for="{{timeOptions}}"
        wx:key="*this"
        data-value="{{item}}"
        bindtap="selectTime"
      >{{item}}</view>
    </view>
  </view>

  <!-- 金额 -->
  <view class="section">
    <view class="section-title">悬赏金额<text class="required">*</text></view>
    <view class="chip-row">
      <view
        class="chip {{money === ('' + item) ? 'active' : ''}}"
        wx:for="{{quickPrices}}"
        wx:key="*this"
        data-value="{{item}}"
        bindtap="setQuickPrice"
      >¥{{item}}</view>
    </view>
    <view class="price-input-row">
      <text class="price-symbol">¥</text>
      <input class="price-input" type="digit" value="{{money}}" placeholder="自定义金额" placeholder-class="ph" data-field="money" bindinput="onInput" />
    </view>
  </view>

  <!-- 联系方式 -->
  <view class="section">
    <view class="section-title">联系方式</view>
    <view class="field-inline">
      <view class="field-inline-item">
        <text class="field-label">手机号</text>
        <input class="field-input" type="number" maxlength="11" value="{{phoneNumber}}" placeholder="接收通知" placeholder-class="ph" data-field="phoneNumber" bindinput="onInput" />
      </view>
      <view class="field-inline-item">
        <text class="field-label">微信号</text>
        <input class="field-input" value="{{wechatId}}" placeholder="方便沟通" placeholder-class="ph" data-field="wechatId" bindinput="onInput" />
      </view>
    </view>
    <view class="field">
      <text class="field-label">备注</text>
      <textarea class="field-textarea" value="{{remark}}" maxlength="120" placeholder="其他需要说明的事项（选填）" placeholder-class="ph" data-field="remark" bindinput="onInput" />
    </view>
  </view>

  <view class="submit-bar">
    <button class="btn btn-ghost" bindtap="goBack">取消</button>
    <button class="btn btn-primary submit-btn" loading="{{submitting}}" bindtap="submit">发布任务</button>
  </view>
</view>
