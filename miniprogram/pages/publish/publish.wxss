/* 发布需求 */
.page {
  padding: 20rpx 24rpx 40rpx;
}

.section {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.required {
  color: #ff3b30;
  margin-left: 6rpx;
}

/* 类型 */
.type-row {
  display: flex;
  gap: 16rpx;
}

.type-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 27rpx;
  color: #007aff;
  background: rgba(0, 122, 255, 0.08);
}

.type-btn.active {
  background: #007aff;
  color: #fff;
  font-weight: 600;
}

/* 字段 */
.field {
  margin-bottom: 24rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: #6e6e73;
  margin-bottom: 12rpx;
}

.field-input {
  width: 100%;
  height: 76rpx;
  background: #f7f8fa;
  border-radius: 14rpx;
  padding: 0 22rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.field-textarea {
  width: 100%;
  min-height: 140rpx;
  background: #f7f8fa;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.ph {
  color: #b0b0b5;
  font-size: 27rpx;
}

.field-inline {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.field-inline-item {
  flex: 1;
  min-width: 0;
}

/* chips */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  padding: 12rpx 26rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  background: #f2f2f7;
  color: #3a3a3c;
}

.chip.active {
  background: #007aff;
  color: #fff;
  font-weight: 600;
}

/* 地址 */
.address-row {
  display: flex;
  align-items: center;
  background: #f7f8fa;
  border-radius: 14rpx;
  padding: 0 16rpx 0 20rpx;
  margin-bottom: 18rpx;
  height: 88rpx;
}

.point {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 21rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.point.start {
  background: #34c759;
}

.point.end {
  background: #ff3b30;
}

.address-input {
  flex: 1;
  background: transparent;
  border: none;
  height: 88rpx;
  padding: 0;
}

.locate-btn {
  flex-shrink: 0;
  font-size: 25rpx;
  color: #007aff;
  padding: 8rpx 12rpx;
}

/* 金额 */
.price-input-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  background: #f7f8fa;
  border-radius: 14rpx;
  padding: 0 22rpx;
  height: 84rpx;
}

.price-symbol {
  font-size: 30rpx;
  color: #ff3b30;
  font-weight: 700;
  margin-right: 10rpx;
}

.price-input {
  flex: 1;
  height: 84rpx;
  font-size: 30rpx;
}

/* 提交 */
.submit-bar {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.submit-bar .btn {
  flex: 1;
  margin: 0;
}

.submit-btn {
  flex: 2 !important;
}
