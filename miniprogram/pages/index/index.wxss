/* 首页 */
.hero {
  background: linear-gradient(160deg, #007aff 0%, #3aa0ff 100%);
  padding: 40rpx 36rpx 56rpx;
  color: #fff;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.hero-school {
  display: inline-flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 24rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #7dffb0;
  margin-right: 10rpx;
}

/* 快捷发布 */
.quick-row {
  display: flex;
  gap: 20rpx;
  padding: 0 24rpx;
  margin-top: -32rpx;
}

.quick-card {
  flex: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 26rpx 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
}

.quick-card:active {
  transform: scale(0.97);
}

.quick-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 14rpx;
}

.quick-icon.express {
  background: #007aff;
}

.quick-icon.meal {
  background: #ff9500;
}

.quick-main {
  font-size: 30rpx;
  font-weight: 700;
}

.quick-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8e8e93;
}

/* 搜索 */
.search-wrap {
  padding: 24rpx 24rpx 0;
}

.search-box {
  display: flex;
  align-items: center;
  height: 76rpx;
  background: #fff;
  border-radius: 38rpx;
  padding: 0 12rpx 0 24rpx;
}

.search-icon {
  font-size: 32rpx;
  color: #8e8e93;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-ph {
  color: #b0b0b5;
  font-size: 28rpx;
}

.search-btn {
  padding: 10rpx 26rpx;
  background: #007aff;
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
}

/* 筛选 */
.filter-row {
  display: flex;
  gap: 14rpx;
  padding: 24rpx 24rpx 0;
  overflow-x: auto;
}

.filter-tab {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #007aff;
  background: rgba(0, 122, 255, 0.1);
}

.filter-tab.active {
  background: #007aff;
  color: #fff;
}

/* 任务市场 */
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 32rpx 32rpx 16rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
}

.section-count {
  font-size: 24rpx;
  color: #8e8e93;
}

.list {
  padding: 0 24rpx 40rpx;
}

.task-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-title {
  margin-top: 18rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.45;
}

.task-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6e6e73;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.tags {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.mini-tag {
  font-size: 22rpx;
  color: #6e6e73;
  background: #f2f2f7;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.route {
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
}

.route-line {
  display: flex;
  align-items: center;
  margin: 6rpx 0;
}

.point {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  font-size: 20rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.point.start {
  background: #34c759;
}

.point.end {
  background: #ff3b30;
}

.point-text {
  font-size: 26rpx;
  color: #3a3a3c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
}

.task-time {
  font-size: 24rpx;
  color: #8e8e93;
}
