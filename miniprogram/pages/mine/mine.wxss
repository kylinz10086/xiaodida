/* 我的 */
.page {
  padding: 0 0 60rpx;
}

.profile {
  display: flex;
  align-items: center;
  padding: 48rpx 36rpx;
  background: linear-gradient(160deg, #007aff 0%, #3aa0ff 100%);
  color: #fff;
}

.avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  font-weight: 700;
  margin-right: 26rpx;
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 38rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}

.edit {
  margin-left: 16rpx;
  font-size: 22rpx;
  font-weight: 400;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.24);
}

.profile-school {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

/* 统计 */
.stats {
  display: flex;
  background: #fff;
  margin: -28rpx 24rpx 0;
  border-radius: 24rpx;
  padding: 28rpx 0;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.06);
  position: relative;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat + .stat {
  border-left: 1rpx solid #efeff4;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #1c1c1e;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8e8e93;
}

/* 分组 */
.group {
  background: #fff;
  border-radius: 24rpx;
  margin: 24rpx;
  padding: 0 28rpx;
}

.group .cell {
  border-bottom: 1rpx solid #f4f4f6;
}

.group .cell:last-child {
  border-bottom: none;
}

.danger {
  color: #ff3b30;
}

.footer {
  text-align: center;
  font-size: 22rpx;
  color: #b0b0b5;
  margin-top: 40rpx;
}
