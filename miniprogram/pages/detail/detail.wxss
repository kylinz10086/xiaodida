/* 任务详情 */
.page {
  padding: 20rpx 24rpx 180rpx;
}

.overview {
  background: linear-gradient(150deg, #007aff 0%, #4aa8ff 100%);
  border-radius: 26rpx;
  padding: 32rpx;
  color: #fff;
  margin-bottom: 20rpx;
}

.overview-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.overview .tag {
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
}

.overview .status {
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
}

.overview-title {
  margin-top: 20rpx;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.4;
}

.overview-price {
  margin-top: 18rpx;
  display: flex;
  align-items: baseline;
}

.overview-price .price-symbol,
.overview-price .price-value {
  color: #fff;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #000;
  margin-bottom: 18rpx;
}

.desc {
  font-size: 28rpx;
  line-height: 1.65;
  color: #3a3a3c;
}

/* 路线 */
.route-line {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.point {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.point.start {
  background: #34c759;
}

.point.end {
  background: #ff3b30;
}

.route-text {
  flex: 1;
  font-size: 28rpx;
  color: #3a3a3c;
}

/* 明细 */
.kv {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 27rpx;
}

.kv-k {
  color: #8e8e93;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.kv-v {
  color: #1c1c1e;
  text-align: right;
  flex: 1;
  word-break: break-all;
}

/* 联系人 */
.contact-row {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.contact-btn {
  flex: 1;
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #007aff;
  background: rgba(0, 122, 255, 0.08);
}

.hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8e8e93;
  line-height: 1.5;
}

/* 时间线 */
.timeline-item {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.tl-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #007aff;
  margin-right: 16rpx;
}

.tl-dot.done {
  background: #34c759;
}

.tl-dot.cancel {
  background: #8e8e93;
}

.tl-text {
  font-size: 26rpx;
  color: #3a3a3c;
}

/* 底部操作 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.action-bar .btn {
  flex: 1;
  margin: 0;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}
