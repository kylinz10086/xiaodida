<view class="page">
  <!-- 角色 -->
  <view class="role-row">
    <view class="role-tab {{role === 'all' ? 'active' : ''}}" data-role="all" bindtap="changeRole">全部</view>
    <view class="role-tab {{role === 'publisher' ? 'active' : ''}}" data-role="publisher" bindtap="changeRole">我发布的</view>
    <view class="role-tab {{role === 'runner' ? 'active' : ''}}" data-role="runner" bindtap="changeRole">我接的单</view>
  </view>

  <!-- 状态 -->
  <view class="status-row">
    <view class="status-tab {{status === 'all' ? 'active' : ''}}" data-status="all" bindtap="changeStatus">
      全部<text class="badge" wx:if="{{counts.all > 0}}">{{counts.all}}</text>
    </view>
    <view class="status-tab {{status === '1' ? 'active' : ''}}" data-status="1" bindtap="changeStatus">
      待接单<text class="badge" wx:if="{{counts.p1 > 0}}">{{counts.p1}}</text>
    </view>
    <view class="status-tab {{status === '2' ? 'active' : ''}}" data-status="2" bindtap="changeStatus">
      进行中<text class="badge" wx:if="{{counts.p2 > 0}}">{{counts.p2}}</text>
    </view>
    <view class="status-tab {{status === '3' ? 'active' : ''}}" data-status="3" bindtap="changeStatus">
      已完成<text class="badge" wx:if="{{counts.p3 > 0}}">{{counts.p3}}</text>
    </view>
  </view>

  <!-- 列表 -->
  <view class="list">
    <view class="card order" wx:for="{{tasks}}" wx:key="_id" data-id="{{item._id}}" bindtap="goDetail">
      <view class="order-head">
        <view class="order-head-left">
          <text class="tag {{item.tagClass}}">{{item.typeText}}</text>
          <text class="role-label">{{item.roleText}}</text>
        </view>
        <text class="status status-{{item.status}}">{{item.statusText}}</text>
      </view>

      <view class="order-title">{{item.title}}</view>

      <view class="order-route" wx:if="{{item.originName}}">
        <text class="small muted">{{item.originName}} → {{item.destinationName}}</text>
      </view>

      <view class="order-foot">
        <view class="order-meta">
          <text class="price"><text class="price-symbol">¥</text>{{item.moneyText}}</text>
          <text class="order-time">{{item.timeText}}</text>
        </view>

        <view class="order-actions">
          <view
            class="btn btn-danger btn-sm"
            wx:if="{{item.status === 1 && item.role === 'publisher'}}"
            data-id="{{item._id}}"
            catchtap="cancelTask"
          >取消</view>
          <view
            class="btn btn-primary btn-sm"
            wx:if="{{item.status === 2 && item.role === 'runner'}}"
            data-id="{{item._id}}"
            catchtap="completeTask"
          >标记完成</view>
          <view
            class="btn btn-primary btn-sm"
            wx:if="{{item.status === 2 && item.role === 'publisher'}}"
            data-id="{{item._id}}"
            catchtap="confirmTask"
          >确认完成</view>
          <view class="btn btn-ghost btn-sm" wx:if="{{item.status >= 3}}" data-id="{{item._id}}" catchtap="goDetail">查看</view>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{tasks.length === 0}}">
      <view>这里还空着</view>
      <view class="small" style="margin-top: 12rpx;">发布一个需求，或者去首页接一单</view>
      <view class="btn btn-primary" style="width: 300rpx; margin: 36rpx auto 0;" bindtap="goPublish">发布需求</view>
    </view>
  </view>
</view>
