/* 我的订单 */
.page {
  padding: 20rpx 24rpx 40rpx;
}

.role-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.role-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  font-size: 27rpx;
  color: #007aff;
  background: #fff;
}

.role-tab.active {
  background: #007aff;
  color: #fff;
  font-weight: 600;
}

.status-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 22rpx;
  overflow-x: auto;
}

.status-tab {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 12rpx 22rpx;
  border-radius: 30rpx;
  font-size: 25rpx;
  color: #6e6e73;
  background: #fff;
}

.status-tab.active {
  background: #1c1c1e;
  color: #fff;
}

.badge {
  margin-left: 8rpx;
  padding: 0 10rpx;
  height: 30rpx;
  line-height: 30rpx;
  border-radius: 15rpx;
  background: #ff3b30;
  color: #fff;
  font-size: 20rpx;
}

.status-tab.active .badge {
  background: rgba(255, 255, 255, 0.32);
}

/* 订单卡 */
.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-head-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.role-label {
  font-size: 22rpx;
  color: #8e8e93;
}

.order-title {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
}

.order-route {
  margin-top: 12rpx;
}

.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.order-meta {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.order-time {
  font-size: 23rpx;
  color: #8e8e93;
}

.order-actions {
  display: flex;
  gap: 14rpx;
}

.order-actions .btn {
  margin: 0;
}

.order:active {
  background: #fafafa;
}
