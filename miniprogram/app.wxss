/* 校递达 —— 全局样式与设计变量
   配色对齐原 uni-app 项目：iOS 蓝 #007AFF / 背景 #F2F2F7 / 次要文字 #8E8E93 */

page {
  background-color: #f2f2f7;
  color: #000;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}

.page {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.muted {
  color: #8e8e93;
}

.small {
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.divider {
  height: 1rpx;
  background: #efeff4;
  margin: 20rpx 0;
}

/* 类型标签 */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
}

.tag-express {
  color: #007aff;
  background: rgba(0, 122, 255, 0.1);
}

.tag-meal {
  color: #ff9500;
  background: rgba(255, 149, 0, 0.12);
}

.tag-other {
  color: #34c759;
  background: rgba(52, 199, 89, 0.12);
}

/* 状态标签 */
.status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.status-1 { color: #ff9500; background: rgba(255, 149, 0, 0.12); }
.status-2 { color: #007aff; background: rgba(0, 122, 255, 0.1); }
.status-3 { color: #34c759; background: rgba(52, 199, 89, 0.12); }
.status-4 { color: #8e8e93; background: rgba(142, 142, 147, 0.12); }

/* 金额 */
.price {
  color: #ff3b30;
  font-weight: 700;
}

.price-symbol {
  font-size: 24rpx;
}

.price-value {
  font-size: 40rpx;
}

/* 按钮 */
.btn {
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #007aff;
  color: #fff;
}

.btn-primary[disabled] {
  background: #b3d7ff;
  color: #fff;
}

.btn-ghost {
  background: #fff;
  color: #007aff;
  border: 1rpx solid rgba(0, 122, 255, 0.35);
}

.btn-danger {
  background: #fff;
  color: #ff3b30;
  border: 1rpx solid rgba(255, 59, 48, 0.35);
}

.btn-sm {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}

/* 空态 */
.empty {
  padding: 140rpx 0;
  text-align: center;
  color: #8e8e93;
  font-size: 28rpx;
}

.empty-icon {
  width: 140rpx;
  height: 140rpx;
  opacity: 0.35;
  margin-bottom: 24rpx;
}

/* 通用列表行 */
.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
}

.cell-label {
  color: #000;
}

.cell-value {
  color: #8e8e93;
  font-size: 26rpx;
}

.cell-arrow {
  color: #c7c7cc;
  margin-left: 12rpx;
}
